{
  "name": "archlab-saa",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build-local": "next build",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s vi -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "translation-resilience": "0.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.15.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/prompt-cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "rimraf": "6.1.3",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
